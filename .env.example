# Which landing page is served at "/": general | hvac  (default: general)
# Read at build time — rebuild (or restart `next dev`) after changing it.
LANDING_PAGE=general

# Public base URL of the Ringgy NestJS API. Read on the server for the pricing
# section and the backoffice proxy (backoffice browser calls go to
# /backoffice/api on this app's own origin and are proxied there, so the admin
# login cookie is first-party in production even when the API is on another
# domain). Also inlined for the contact form, which posts to it directly.
NEXT_PUBLIC_API_URL=http://localhost:8000

# The customer portal (signup + dashboard). Every "Try for Free" button links to
# its /signup page. Inlined at build time, like the values below.
PORTAL_URL=http://localhost:3000

# Live demo line dialled by every "Make a Demo Call" button (E.164).
DEMO_PHONE_NUMBER=+18884927464

# Footer social icons. Leave one empty to hide its icon.
LINKEDIN_URL=#
TWITTER_URL=#
