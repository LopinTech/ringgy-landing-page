# Which landing page is served at "/": general | hvac  (default: general)
# Read at build time — rebuild (or restart `next dev`) after changing it.
LANDING_PAGE=general

# Backoffice (/backoffice): base URL of the Ringgy NestJS API. Inlined at build time.
# The API's CORS must allow this app's origin (FRONTEND_ORIGIN, default http://localhost:3002).
NEXT_PUBLIC_API_URL=http://localhost:8000

# The customer app (signup + dashboard). Every "Start for Free" button links to
# its /signup page. Inlined at build time.
NEXT_PUBLIC_APP_URL=http://localhost:3000
